# Container topology only; everything else belongs in meercal.toml.
# Precedence: environment > .env > meercal.toml > built-in default.

# Where docker compose publishes the UI. Keep the 127.0.0.1 prefix unless you
# have put TLS and a password in front of it.
MEERCAL_BIND=127.0.0.1
MEERCAL_PORT=8010

# The zone the calendar is drawn in, for as long as meercal.toml says
# timezone = "system". A container's own system zone is UTC, so without this
# line "system" means UTC rather than yours, and every timed event is drawn an
# hour or two out -- plausibly, which is the worst way for it to be wrong. Use
# an IANA name (Europe/Berlin, America/New_York); meercal.sh fills in the zone
# of the machine it installed on. A zone named in meercal.toml still wins.
TZ=

# The bundled Postgres. Change the password here and in meercal.toml: the
# Postgres image only takes its credentials from the environment.
POSTGRES_USER=meercal
POSTGRES_PASSWORD=meercal
POSTGRES_DB=meercal
# Host port for the bundled database. 5433, not 5432: meerail's stack already
# has that one, and the two are expected to run side by side.
MEERCAL_DB_PORT=5433

# The uid/gid that owns meercal.toml. It is mode 0600 and holds calendar
# passwords, so the containers that read it run as its owner rather than as the
# image's own user; the agent refuses to start if the file is readable by
# anyone else. meercal.sh writes your ids here at install time, and `make up`
# passes them on the command line — set them if you run `docker compose up`
# directly from a checkout, or the two containers cannot read the file.
MEERCAL_UID=1000
MEERCAL_GID=1000
